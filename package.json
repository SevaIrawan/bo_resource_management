{
  "name": "resource-management",
  "version": "0.1.1",
  "private": true,
  "description": "Resource Management Desktop — Group Monitoring Dashboard",
  "author": "Seva Irawan <tanjungbambangirawan85@gmail.com>",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-telegram-sidecar.ps1",
    "build:app": "vite build && electron-builder --win",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:handbook-docs": "node scripts/build-handbook-documents.mjs",
    "build:handbook-pdf": "npm run build:handbook-docs",
    "build": "npm run build:installer",
    "publish:github": "powershell -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "build:dir": "vite build && electron-builder --win --dir",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:session-flow": "node scripts/validate-session-column-flow.mjs",
    "validate:multi-account-wa": "node scripts/validate-multi-account-wa.mjs",
    "validate:telegram-login": "node scripts/validate-telegram-login-flow.mjs",
    "validate:desktop": "npm run validate:session-flow && npm run validate:multi-account-wa && npm run validate:telegram-login",
    "audit:reload": "node scripts/audit-reload-all-flow.mjs",
    "diagnose:session": "node scripts/diagnose-session.mjs",
    "repair:wa-session": "node scripts/repair-wa-session.mjs",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:python": "py -3 -m pip install -r python-sidecar/requirements.txt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.511.0",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "tailwind-merge": "^3.3.0",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "html-to-docx": "^1.8.0",
    "marked": "^18.0.4",
    "md-to-pdf": "^5.2.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.resourcemanagement.app",
    "productName": "Resource Management",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/whatsapp-web.js/**",
      "**/node_modules/puppeteer/**",
      "**/node_modules/puppeteer-core/**",
      "**/node_modules/@puppeteer/**"
    ],
    "extraResources": [
      {
        "from": "resources/sidecar/rm-telegram-sidecar.exe",
        "to": "sidecar/rm-telegram-sidecar.exe"
      },
      {
        "from": "resources/env-template.env",
        "to": "env-template.env"
      },
      {
        "from": "resources/org-default.env",
        "to": "org-default.env"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Resource Management",
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "SevaIrawan",
      "repo": "bo_resource_management"
    }
  }
}
