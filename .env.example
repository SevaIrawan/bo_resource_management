# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Settings → API

# Project URL
VITE_SUPABASE_URL=

# anon / public key — untuk app (dashboard login, RLS)
# Di Supabase UI biasa label: "anon" "public"
VITE_SUPABASE_ANON_KEY=

# service_role key — BACKEND ONLY (Electron main / Python sidecar)
# JANGAN pakai prefix VITE_ — bypass RLS, sangat rahasia
# Opsional untuk MVP; diperlukan jika scraper write tanpa user login
SUPABASE_SERVICE_ROLE_KEY=

# ─── Telegram / Telethon (BACKEND ONLY) ─────────────────────────────────────
# https://my.telegram.org → API Development tools
# 1 pasang API ID + Hash untuk SEMUA akun Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─── WhatsApp (whatsapp-web.js) ─────────────────────────────────────────────
# Tidak ada API key — login QR atau pairing code (nomor HP)
