# Resource Management — konfigurasi untuk PC ini
# Lokasi setelah install: %APPDATA%\Resource Management\.env
# Isi nilai di bawah, simpan, lalu buka ulang aplikasi.

# Supabase → Dashboard → Settings → API
VITE_SUPABASE_URL=
# service_role — dibundel tim IT; tidak perlu diisi user akhir
SUPABASE_SERVICE_ROLE_KEY=

# Telegram → https://my.telegram.org (satu pasang untuk semua akun TG)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
