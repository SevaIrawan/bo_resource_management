{
  "name": "resource-management",
  "version": "1.0.36",
  "private": true,
  "description": "Resource Management Desktop — Group Monitoring Dashboard",
  "author": "Seva Irawan <tanjungbambangirawan85@gmail.com>",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:sidecar": "node scripts/build-telegram-sidecar.mjs",
    "build:chrome": "node scripts/build-puppeteer-chrome.mjs",
    "build:app": "node -e \"console.error('DEPRECATED: npm run build:installer');process.exit(1)\"",
    "build:app:win": "node -e \"console.error('DEPRECATED: npm run build:installer:win');process.exit(1)\"",
    "build:app:mac": "node -e \"console.error('DEPRECATED: npm run build:installer:mac');process.exit(1)\"",
    "build:app:linux": "node -e \"console.error('DEPRECATED: npm run build:installer:linux');process.exit(1)\"",
    "build:installer": "node scripts/build-installer.mjs",
    "build:installer:win": "node scripts/build-installer.mjs win",
    "build:installer:mac": "node scripts/build-installer.mjs mac",
    "build:installer:linux": "node scripts/build-installer.mjs linux",
    "build:operator": "powershell -ExecutionPolicy Bypass -File scripts/build-operator-installer.ps1",
    "build:handbook-docs": "node scripts/build-handbook-documents.mjs",
    "build:handbook-pdf": "npm run build:handbook-docs",
    "build": "npm run build:installer",
    "publish:github": "powershell -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "build:dir": "node -e \"console.error('DEPRECATED: npm run build:installer:win');process.exit(1)\"",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "validate:session-flow": "node scripts/validate-session-column-flow.mjs && node scripts/validate-session-account-resolve.mjs && node scripts/validate-clear-session.mjs",
    "validate:master-reference": "node scripts/audit-project-master-reference.mjs",
    "validate:sync-scraper-spec": "node scripts/validate-sync-scraper-spec.mjs",
    "validate:auto-scrape": "node scripts/validate-auto-scrape.mjs",
    "validate:gm-master-contract": "node scripts/validate-gm-master-contract.mjs",
    "validate:multi-account-wa": "node scripts/validate-multi-account-wa.mjs",
    "validate:telegram-login": "node scripts/validate-telegram-login-flow.mjs",
    "validate:puppeteer-chrome": "node scripts/validate-puppeteer-chrome.mjs",
    "validate:wa-qr-login": "node scripts/validate-wa-qr-login-flow.mjs",
    "validate:electron-imports": "node scripts/validate-electron-runtime-imports.mjs",
    "validate:post-login-sync": "node scripts/validate-post-login-sync.mjs",
    "validate:device-group-scale": "node scripts/validate-device-group-scale.mjs",
    "validate:installer-electron-config": "node scripts/validate-installer-electron-config.mjs",
    "validate:installer-pipeline": "node scripts/audit-installer-pipeline.mjs",
    "validate:all-platform-artifacts": "node scripts/validate-all-platform-artifacts.mjs",
    "validate:installer-package": "node scripts/validate-installer-package.mjs",
    "validate:installer-runtime": "node scripts/validate-installer-runtime.mjs",
    "validate:release-artifact": "node scripts/validate-release-artifact.mjs",
    "validate:installer-bundle": "node scripts/validate-installer-package.mjs && node scripts/validate-puppeteer-chrome.mjs && node scripts/validate-installer-runtime.mjs",
    "validate:full-build-audit": "node scripts/validate-full-build-audit.mjs",
    "validate:refresh-notification": "node scripts/validate-refresh-notification.mjs",
    "validate:brand-card-badges": "node scripts/validate-brand-card-badges.mjs",
    "validate:kpi-five-cards": "node scripts/validate-kpi-five-cards.mjs",
    "validate:release-version": "node scripts/validate-release-version.mjs",
    "validate:brand-card-filter": "node scripts/validate-brand-card-filter.mjs",
    "validate:brand-remove-detail": "node scripts/validate-brand-remove-detail.mjs",
    "validate:account-slot-lifecycle": "node scripts/validate-account-slot-lifecycle.mjs",
    "validate:reporting-matrix": "node scripts/validate-reporting-matrix.mjs",
    "validate:operations-stock": "node scripts/validate-operations-stock.mjs",
    "validate:operations-job-queue": "node scripts/validate-operations-job-queue.mjs",
    "validate:join-csv-import": "node scripts/validate-join-csv-import.mjs",
    "validate:real-operations-data": "node scripts/validate-real-operations-data.mjs",
    "validate:worker-platform-settings": "node scripts/validate-worker-platform-settings.mjs",
    "validate:grid-db-live": "node scripts/validate-grid-db-live.mjs",
    "validate:org-env": "node scripts/validate-org-env.mjs",
    "validate:production-white-window-fix": "node scripts/validate-production-white-window-fix.mjs",
    "validate:release-upload": "node scripts/validate-release-upload.mjs",
    "validate:user-permissions": "node scripts/validate-user-permissions.mjs",
    "validate:cross-platform-build": "node scripts/validate-cross-platform-build.mjs",
    "validate:desktop": "npm run validate:session-flow && npm run validate:sync-scraper-spec && npm run validate:auto-scrape && npm run validate:gm-master-contract && npm run validate:multi-account-wa && npm run validate:telegram-login && npm run validate:puppeteer-chrome && npm run validate:wa-qr-login && npm run validate:electron-imports && npm run validate:post-login-sync && npm run validate:device-group-scale && npm run validate:real-operations-data && npm run validate:installer-package && npm run validate:installer-electron-config && npm run validate:refresh-notification && npm run validate:brand-card-badges && npm run validate:kpi-five-cards && npm run validate:release-version && npm run validate:brand-card-filter && npm run validate:brand-remove-detail && npm run validate:operations-job-queue && npm run validate:join-csv-import && npm run validate:cross-platform-build",
    "validate:pre-release": "npm run validate:desktop && npm run validate:worker-platform-settings && npm run validate:reporting-matrix && npm run validate:grid-db-live && npm run validate:org-env && npm run validate:production-white-window-fix && npm run validate:release-upload && npm run validate:user-permissions && npm run typecheck",
    "audit:reload": "node scripts/audit-reload-all-flow.mjs",
    "diagnose:session": "node scripts/diagnose-session.mjs",
    "repair:wa-session": "node scripts/repair-wa-session.mjs",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:python": "py -3 -m pip install -r python-sidecar/requirements.txt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.511.0",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "tailwind-merge": "^3.3.0",
    "puppeteer": "^24.38.0",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "html-to-docx": "^1.8.0",
    "marked": "^18.0.4",
    "md-to-pdf": "^5.2.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.resourcemanagement.app",
    "productName": "Resource Management",
    "directories": {
      "output": "release"
    },
    "win": {
      "artifactName": "Resource.Management.Setup.${version}.${ext}",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "resources/sidecar/rm-telegram-sidecar.exe",
          "to": "sidecar/rm-telegram-sidecar.exe"
        }
      ]
    },
    "mac": {
      "artifactName": "Resource.Management-${version}-${arch}-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/sidecar/rm-telegram-sidecar",
          "to": "sidecar/rm-telegram-sidecar"
        }
      ]
    },
    "linux": {
      "artifactName": "Resource.Management-${version}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "resource-management",
      "extraResources": [
        {
          "from": "resources/sidecar/rm-telegram-sidecar",
          "to": "sidecar/rm-telegram-sidecar"
        }
      ]
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!resources/sidecar-build/**",
      "!resources/sidecar-dist/**"
    ],
    "asarUnpack": [
      "**/node_modules/whatsapp-web.js/**",
      "**/node_modules/puppeteer/**",
      "**/node_modules/puppeteer-core/**",
      "**/node_modules/@puppeteer/**"
    ],
    "extraResources": [
      {
        "from": "resources/env-template.env",
        "to": "env-template.env"
      },
      {
        "from": "resources/org-default.env",
        "to": "org-default.env"
      },
      {
        "from": "resources/puppeteer-cache/chrome",
        "to": "puppeteer-chrome/chrome"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Resource Management",
      "differentialPackage": false
    }
  }
}
